{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "node --test tests/Unit/*.test.js",
        "test:browser": "node tests/Browser/run.mjs",
        "test:reports": "node tests/Browser/run.mjs --reports",
        "test:print": "node tests/Browser/run.mjs --print",
        "test:readings": "node tests/Browser/run.mjs --readings",
        "check:release": "npm run check -- --apk && npm run test:browser && npm run test:reports && npm run test:print && npm run test:readings",
        "check": "node .claude/automation/check.mjs --full",
        "check:changed": "node .claude/automation/check.mjs --changed",
        "check:watch": "node .claude/automation/watch.mjs",
        "check:status": "node .claude/automation/check.mjs --status",
        "lint": "eslint resources/js --max-warnings 0 && node --test tests/Unit/spacingScale.test.js",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write resources/js resources/css",
        "test:components": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/postcss": "^4.3.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.9",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "concurrently": "^10.0.3",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "laravel-vite-plugin": "^3.1",
        "playwright": "^1.64.1",
        "postcss": "^8.4.31",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.0.0",
        "vitest": "^5.1.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@heroui/react": "^3.2.7",
        "@inertiajs/react": "^3.7.1",
        "@internationalized/date": "^3.12.4",
        "@react-aria/ssr": "^3.10.1",
        "@react-aria/utils": "^3.34.1",
        "@vitejs/plugin-react": "^6.1.1",
        "exceljs": "^4.4.0",
        "pdfjs-dist": "6.4.299",
        "react": "^19.3.0",
        "react-aria": "^3.53.1",
        "react-aria-components": "^1.22.1",
        "react-dom": "^19.3.0"
    }
}
